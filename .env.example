# docker-compose.yml이 읽는 설정의 예시이다. 이 파일을 .env로 복사해서 필요한 값만 채운다.
#
#   cp .env.example .env
#
# .env는 repository에 넣지 않는다. 여기 있는 이름은 전부 선택이며, .env가 아예 없어도 전체 stack은
# docker-compose.yml에 적힌 기본값으로 그대로 뜬다.
#
# 이 파일에는 실제 credential을 적지 않는다. 예시로 그럴듯한 값을 적어 두면 그 값이 어딘가에서 실제
# 설정으로 복사되고, 진짜 secret처럼 보여 확인하는 사람의 시간을 뺏는다.

# --- Database ---------------------------------------------------------------
# 로컬 데모용 계정이다. 비워 두면 demoshop/pulseops라는 기본값이 쓰인다. 운영에서 쓸 값이 아니다.
# 이 값을 바꾸려면 MySQL volume이 비어 있어야 한다. 계정은 첫 기동에서 한 번만 만들어진다.
MYSQL_ROOT_PASSWORD=
DEMO_SHOP_DB_NAME=
DEMO_SHOP_DB_USER=
DEMO_SHOP_DB_PASSWORD=
PULSEOPS_DB_NAME=
PULSEOPS_DB_USER=
PULSEOPS_DB_PASSWORD=

# --- Grafana ----------------------------------------------------------------
# 관리자 계정의 비밀번호이다. 비워 두면 admin이 된다. 화면을 보는 데는 로그인이 필요 없고, 설정을
# 바꿀 때만 필요하다.
GRAFANA_ADMIN_PASSWORD=

# --- Fault Injection --------------------------------------------------------
# Demo Shop에 장애를 주입할 수 있게 한다. 기본은 false이며, true일 때만 X-Demo-Fault Header가 의미를
# 갖는다. Demo와 검증에서만 켠다.
DEMO_SHOP_FAULT_INJECTION_ENABLED=

# --- Claude Incident Analysis (선택) ----------------------------------------
# Incident가 만들어진 뒤 사람이 요청했을 때만 Claude를 부르는 기능이다. 장애를 탐지하는 데는 쓰이지
# 않는다. 셋을 모두 채우지 않으면 꺼진 채로 남고, 그래도 나머지 기능은 전부 동작한다.
#
# API key를 이 파일에 적지 않는다. 값은 .env에만 넣는다.
PULSEOPS_AI_CLAUDE_ENABLED=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# --- GitHub Incident Code Context (선택) ------------------------------------
# Incident와 관련 있어 보이는 소스와 직전 commit을 GitHub에서 모으는 기능이다. 읽기 권한만 필요하며
# commit도 branch도 PR도 만들지 않는다. 사람이 요청했을 때만 호출한다.
#
# token을 이 파일에 적지 않는다. 값은 .env에만 넣는다.
PULSEOPS_GITHUB_ENABLED=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_REF=
